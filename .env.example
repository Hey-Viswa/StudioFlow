# Shared environment variables for StudioFlow
# Copy this file to .env and fill in your actual values

# Backend configuration
MONGO_URI=your-mongodb-atlas-connection-string
JWT_SECRET=your-secure-jwt-secret-min-32-characters
PORT=5000

# Frontend URL (used for invite links - change when deploying)
FRONTEND_URL=http://localhost:3000

# Clerk Configuration (https://clerk.com)
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_JWKS_URL=your-clerk-jwks-url
CLERK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Razorpay Configuration (https://razorpay.com)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Frontend configuration (must retain VITE_ prefix for Vite exposure)
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
VITE_API_URL=http://localhost:5000/api
